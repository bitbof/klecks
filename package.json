{
  "type": "module",
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "scripts": {
    "start": "parcel serve src/index.html --no-cache",
    "build": "parcel build src/index.html src/help.html --public-url .",
    "build:embed": "parcel build src/embed.ts src/help.html --public-url .",
    "lang:add": "node src/languages/generate.js add",
    "lang:sync": "node src/languages/generate.js sync",
    "lang:build": "node src/languages/generate.js build",
    "icon:build": "node src/icons/generate.js"
  },
  "dependencies": {
    "@parcel/service-worker": "2.16.4",
    "@parcel/transformer-glsl": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "ag-psd": "28.3.1",
    "buffer": "6.0.3",
    "js-beautify": "1.15.4",
    "json5": "2.2.3",
    "parcel": "2.16.4",
    "polygon-clipping": "0.15.7",
    "transformation-matrix": "3.1.0"
  },
  "devDependencies": {
    "csstype": "^3.2.3"
  }
}
